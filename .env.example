# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173

# LangSmith tracing (optional) — https://smith.langchain.com
LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=   # accepted as alias for LANGSMITH_API_KEY
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=doc-processing-ai
