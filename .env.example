# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Evals (answers + faithfulness judge) use a lite model for its higher free daily quota
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Postgres + pgvector (docker compose up -d postgres). Change POSTGRES_PORT if 5432 is taken,
# and keep the port in DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# Retrieval: vector | hybrid | hybrid_rerank
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_CANDIDATES=20
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173

# LangSmith tracing (optional) — https://smith.langchain.com
LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=   # accepted as alias for LANGSMITH_API_KEY
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=doc-processing-ai

# Langfuse tracing (optional): set both keys to trace retrieval stages and LLM calls.
# For a local Langfuse, run `docker compose -f docker-compose.langfuse.yml up -d` and use:
#   LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
#   LANGFUSE_SECRET_KEY=sk-lf-local-dev
#   LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
