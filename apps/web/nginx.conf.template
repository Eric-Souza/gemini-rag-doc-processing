server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same contract as the Vite dev proxy: /api/health goes to the API as /health
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The chat streams its answer over SSE, so nothing may be buffered
        proxy_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 25m;
    }

    location /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri /index.html;
    }
}
